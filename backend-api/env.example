# --- Supabase ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Pakai SERVICE ROLE KEY (Settings > API di dashboard Supabase).
# Rahasia! Jangan pernah ditaruh di frontend atau dikirim ke Engineer.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- MinIO ---
# DB cuma menyimpan PATH objek (mis. "frames/throw_01.jpg"); http-nya dibangun di kode.
# URL akhir = {MINIO_PUBLIC_URL}/{MINIO_BUCKET}/{path}
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=detections

# --- Opsional ---
# Kalau diisi, semua request harus kirim header: X-API-Key: <nilai ini>
API_KEY=
TABLE_NAME=vehicle_detection
CORS_ORIGINS=*
